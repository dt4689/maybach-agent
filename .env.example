# ── Twilio (WhatsApp) ────────────────────────────────────────────────
# Sandbox today, real Maybach number later — ONLY these three change.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886   Production: whatsapp:+919892904433
TWILIO_WHATSAPP_NUMBER=

# ── Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# PLACEHOLDER model — isolated in one constant (config/business.js AI_MODEL).
# Swap to a Fable/Mythos model string later by changing only this line.
AI_MODEL=claude-sonnet-4-20250514

# ── Supabase (Postgres persistence) ──────────────────────────────────
# Server-side only — use the SERVICE ROLE key, never the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets (live fleet + availability, read-only) ─────────────
# TODO(dhruv): supply the real Sheet ID and share the sheet with the
# service account email. Leave blank to use the hardcoded fleet fallback.
GOOGLE_SHEETS_ID=
# Paste the FULL service-account JSON on one line (or leave blank).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Lead alerts ──────────────────────────────────────────────────────
OWNER_WHATSAPP=+919892904433

# ── Admin dashboard ──────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── Server ───────────────────────────────────────────────────────────
PORT=3000
